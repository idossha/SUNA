# deps
node_modules/
.pnpm-store/

# build output
dist/
out/
*.tsbuildinfo

# electron
apps/desktop/release/
/release/
# staged before electron-builder copies it into Contents/Resources
apps/desktop/build/resources/

# python
__pycache__/
*.egg-info/
.venv/
.uv/

# tooling caches
.vite/
.turbo/
coverage/

# os / editor
.DS_Store
*.local

# "Repair this UI" bundles (feature-plan-8 §2b) — local reports, never committed
bug-reports/

# secrets — never commit keys
.env
.env.*
.claude/settings.local.json
scripts/e2e/.artifacts/
scripts/e2e/.userdata-*/
packages/agent/dist-mcp/
.playwright-mcp/

# examples/ is IGNORED BY DEFAULT, and hello-suna is the one exception.
#
# Real manuscripts, cover letters, referee reports and colleagues' proposals
# get dropped in here as ground truth for export and importer work. They are
# personal documents — several of them other people's — and none of them may
# reach the repo. Ignoring the directory and opting hello-suna back in means a
# new folder of them is safe the moment it lands, rather than safe only if
# somebody remembers to add a line here.
#
# Shipping another example project? Add its own `!examples/<name>/` below.
examples/*
!examples/hello-suna/

# docs site build artifacts (website/.vitepress/dist is covered by dist/)
website/.vitepress/cache/
# The site's Developers section is a MIRROR of docs/ and AGENTS.md, written by
# website/scripts/sync-docs.mjs on every docs:dev / docs:build. Committing it
# would create a second copy of the developer documentation, which is the one
# thing that split is there to prevent.
website/developers/
website/public/shots/*.png
.suna/
