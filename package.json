{
  "name": "suna",
  "private": true,
  "version": "0.1.0",
  "description": "SUNA — academic co-writing platform: manuscripts, figures, references, and publisher-ready output",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "@electron/rebuild"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @suna/desktop dev",
    "smoke": "node scripts/e2e/smoke.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
